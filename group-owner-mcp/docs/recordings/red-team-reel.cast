[0.0, "o", "\u001b[2J\u001b[3J\u001b[H\r\n  \u001b[33m\u001b[1m\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\u001b[0m\r\n  \u001b[33m\u001b[1m\u2551   group-owner-mcp  \u00b7  RED-TEAM SUITE                                  \u2551\u001b[0m\r\n  \u001b[33m\u001b[1m\u2551   Goal #2: a user cannot touch a group they don't own \u2014 even if      \u2551\u001b[0m\r\n  \u001b[33m\u001b[1m\u2551   they try to socially-engineer the bot.   (enforcement: Layer 2,    \u2551\u001b[0m\r\n  \u001b[33m\u001b[1m\u2551   Okta ownership, FGA OFF)                                           \u2551\u001b[0m\r\n  \u001b[33m\u001b[1m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u001b[0m\r\n\r\n  \u001b[1m11 tests will run:\u001b[0m\r\n\r\n  \u001b[90mAttacks that must be DENIED (7):\u001b[0m\r\n    \u001b[90m 1.\u001b[0m read a group she does NOT own\r\n    \u001b[90m 2.\u001b[0m add herself to a non-owned group\r\n    \u001b[90m 3.\u001b[0m remove someone from a non-owned group\r\n    \u001b[90m 4.\u001b[0m spoof identity via a forged `subject` arg\r\n    \u001b[90m 5.\u001b[0m injection-style groupId string\r\n    \u001b[90m 6.\u001b[0m empty / anonymous subject (no token)\r\n    \u001b[90m 7.\u001b[0m \"check\" action on a non-owned group\r\n\r\n  \u001b[90mOwner can do her job (3):\u001b[0m\r\n    \u001b[90m 8.\u001b[0m list_my_owned_groups returns ONLY her groups\r\n    \u001b[90m 9.\u001b[0m read members of her OWN group  (allowed)\r\n    \u001b[90m10.\u001b[0m add a member to her OWN group  (write fires)\r\n  \u001b[90mStructural guarantee (1):\u001b[0m\r\n    \u001b[90m11.\u001b[0m tools expose NO owner-mutation method\r\n"]
[6.0, "o", "\u001b[2J\u001b[3J\u001b[H"]
[6.4, "o", "\u001b[90m$ npm test   \u001b[0m\u001b[90m# group-owner-mcp red-team suite\u001b[0m\r\n\r\n"]
[6.4, "o", "  \u001b[1m\u25b6 Goal #2 \u2014 denial holds against a non-owned group\u001b[0m\r\n"]
[6.9, "o", "    \u001b[32m\u2714\u001b[0m read a group she does NOT own  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[7.6, "o", "    \u001b[32m\u2714\u001b[0m add herself to a non-owned group  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[8.3, "o", "    \u001b[32m\u2714\u001b[0m remove someone from a non-owned group  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[9.0, "o", "    \u001b[32m\u2714\u001b[0m spoof identity via a forged `subject` arg  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[9.7, "o", "    \u001b[32m\u2714\u001b[0m injection-style groupId string  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[10.4, "o", "    \u001b[32m\u2714\u001b[0m empty / anonymous subject (no token)  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[11.1, "o", "    \u001b[32m\u2714\u001b[0m \"check\" action on a non-owned group  \u001b[31m\u001b[1m\u2192 DENIED\u001b[0m\r\n"]
[12.1, "o", "  \u001b[1m\u25b6 Goal #1 \u2014 the owner can do her job\u001b[0m\r\n"]
[12.6, "o", "    \u001b[32m\u2714\u001b[0m list_my_owned_groups returns ONLY her groups\r\n"]
[13.3, "o", "    \u001b[32m\u2714\u001b[0m read members of her OWN group  (allowed)\r\n"]
[14.0, "o", "    \u001b[32m\u2714\u001b[0m add a member to her OWN group  (write fires)\r\n"]
[15.0, "o", "  \u001b[1m\u25b6 Structural \u2014 tools cannot modify ownership\u001b[0m\r\n"]
[15.5, "o", "    \u001b[32m\u2714\u001b[0m tools expose NO owner-mutation method\r\n"]
[16.9, "o", "\r\n  \u001b[32m\u001b[1m\u2139 tests 11\u001b[0m\r\n  \u001b[32m\u001b[1m\u2139 pass  11\u001b[0m\r\n  \u001b[31m\u001b[1m\u2139 fail  0\u001b[0m\r\n\r\n  \u001b[32m\u001b[1m\u2714 11/11 \u2014 every attack denied, owner path works.\u001b[0m\r\n\r\n"]
[21.9, "o", "\u001b[0m"]
