# ---------------------------------------------------------------------------
# group-owner-mcp configuration
#
# Layer 2 (baseline, ALWAYS on) needs only the Okta service credentials below.
# Layer 3 (Okta FGA) is an OPTIONAL enhancement — leave FGA_ENABLED unset/false
# and the server still fully enforces ownership via the Okta ownership gate.
# ---------------------------------------------------------------------------

# --- Okta org + service app (private-key-JWT client credentials) ---
OKTA_DOMAIN=your-org.okta.com
OKTA_ISSUER=https://your-org.okta.com
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY_PATH=./service-key.pem
# Scopes the service app is granted (read owners/members; manage membership).
OKTA_SERVICE_SCOPES=okta.groups.read okta.groups.manage okta.users.read

# --- Identity verification (Layer 1) ---
# When true, the server cryptographically verifies the caller's bearer token
# against the org JWKS before trusting its `sub`. In the deployed topology the
# MCP adapter also validates (bearer passthrough); this is defense-in-depth.
VERIFY_TOKENS=true

# --- Layer 3: Okta FGA (OPTIONAL) ---
# Set FGA_ENABLED=true ONLY to demonstrate externalized authorization.
# With it unset/false, Layer 2 is the enforcement authority.
FGA_ENABLED=false
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
FGA_API_TOKEN_ISSUER=https://auth.fga.dev/oauth/token
FGA_AUDIENCE=https://api.us1.fga.dev/

# --- Server ---
PORT=8080
