# ---------------------------------------------------------------------------
# SuperSafe-AI backend MCP server configuration
#
# The server reads everything from the process environment (there is no dotenv
# loader in the TypeScript code; export these or inject them via your runner,
# ECS task definition, or docker run -e flags).
# ---------------------------------------------------------------------------

# Transport: stdio (local Claude Code) or http (Express server for the adapter,
# CrewAI, and the /api/tool REST shim)
TRANSPORT=http
PORT=3000

# Optional first-party key for the "ApiKey <key>" header path (grants all
# scopes; used by the Bedrock Lambda). Leave unset to disable that path.
# SERVICE_API_KEY=

# --- Salesforce (OAuth client credentials) ---
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=
SFDC_INSTANCE_URL=https://your-org.my.salesforce.com

# --- ServiceNow (HTTP basic auth) ---
SNOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SNOW_USERNAME=
SNOW_PASSWORD=

# --- Okta FGA (Layer 1 tool-invocation checks + Layer 2 record filtering) ---
# Set FGA_ENABLED=false to run without FGA. When enabled, all four values are
# required (checks fail open on errors by design; this is a demo server).
FGA_ENABLED=true
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
