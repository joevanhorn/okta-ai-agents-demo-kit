# Okta Configuration
# Custom Authorization Server token endpoint for the CrewAI Account Risk Monitor app
OKTA_TOKEN_URL=https://taskvantage.okta.com/oauth2/aus22dp8l2sy5rBv21d8/v1/token

# CrewAI Account Risk Monitor service app credentials (from Terraform output or SSM)
OKTA_CLIENT_ID=your-client-id-here
OKTA_KEY_ID=crewai-monitor-key-1

# Private key for JWT signing (RSA PEM format)
# Multi-line PEM string; alternatively, use OKTA_PRIVATE_KEY_FILE to point to a file
OKTA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----

# Optional: Path to RSA private key PEM file (alternative to OKTA_PRIVATE_KEY_PEM)
# If set, takes precedence over OKTA_PRIVATE_KEY_PEM
# OKTA_PRIVATE_KEY_FILE=/path/to/private-key.pem

# Scopes to request from Okta (default ceiling; actual grant determined by Okta policy)
# Default: sfdc:read sfdc:write snow:read (note: snow:write is NOT granted by policy)
MONITOR_SCOPES=sfdc:read sfdc:write snow:read

# MCP Backend Configuration
# The backend MCP server URL (NOT the adapter)
MCP_BACKEND_URL=https://mcp.supersafe-ai.io/mcp

# LLM Configuration — choose ONE of the two options below.
#
# Option A: direct provider key.
#   Set the provider key and MONITOR_LLM to a provider-prefixed model.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MONITOR_LLM=anthropic/claude-haiku-4-5-20251001
#
# Option B: LiteLLM proxy / gateway (recommended if you have a LiteLLM key).
#   CrewAI is LiteLLM under the hood; point it at your proxy and pass the virtual
#   key. LiteLLM proxies are OpenAI-compatible — set MONITOR_LLM to the model name
#   your proxy serves (prefix with "openai/" if it routes there).
# LITELLM_API_BASE=https://your-litellm-proxy.example.com
# LITELLM_API_KEY=sk-your-litellm-virtual-key
# MONITOR_LLM=openai/claude-haiku-4-5

# Monitoring Configuration
# Interval (in seconds) between monitoring passes in --watch mode
WATCH_INTERVAL=300

# AWS Configuration (optional)
# AWS profile to use when pulling credentials from SSM Parameter Store
# Only used if environment variables are absent and AWS credentials available
# AWS_PROFILE=taskvantage
